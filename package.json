  "omp": {
    "name": "Kiro",
    "description": "Kiro AI provider for omp — OAuth login, dynamic model discovery, and streaming inference",
    "extensions": [
      "src/index.ts"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexcerezo/omp-kiro-provider.git"
  },
  "homepage": "https://github.com/alexcerezo/omp-kiro-provider#readme",
  "bugs": {
    "url": "https://github.com/alexcerezo/omp-kiro-provider/issues"
  },
  "devDependencies": {
    "@oh-my-pi/pi-ai": "18.17.0",
    "@oh-my-pi/pi-utils": "18.17.0"
  }
