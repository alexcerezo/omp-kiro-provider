{
  "name": "omp-kiro-provider",
  "version": "2.0.11",
  "description": "Kiro / Amazon Q provider plugin for oh-my-pi (omp): IAM Identity Center, Builder ID, GitHub and Google OAuth, live model discovery, and streaming inference",
  "author": {
    "name": "Alex Cerezo",
    "url": "https://github.com/alexcerezo"
  },
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "bun test",
    "check": "bun test"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "@oh-my-pi/pi-ai": ">=18.12.2",
    "@oh-my-pi/pi-catalog": ">=18.12.2",
    "@oh-my-pi/pi-coding-agent": ">=18.12.2",
    "@oh-my-pi/pi-utils": ">=18.12.2"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "keywords": [
    "omp",
    "omp-plugin",
    "omp-extension",
    "oh-my-pi",
    "kiro",
    "kiro-cli",
    "aws",
    "amazon-q",
    "codewhisperer",
    "iam-identity-center",
    "oauth",
    "provider",
    "claude"
  ],
  "omp": {
    "name": "Kiro",
    "description": "Kiro / Amazon Q provider for omp — OAuth login, live model discovery, and streaming inference",
    "extensions": [
      "src/index.ts"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexcerezo/omp-kiro-provider.git"
  },
  "homepage": "https://github.com/alexcerezo/omp-kiro-provider#readme",
  "bugs": {
    "url": "https://github.com/alexcerezo/omp-kiro-provider/issues"
  },
  "devDependencies": {
    "@oh-my-pi/pi-ai": "18.17.0",
    "@oh-my-pi/pi-utils": "18.17.0"
  }
}
