{
  "name": "omp-kiro-provider",
  "version": "2.0.8",
  "description": "Kiro AI provider plugin for omp — OAuth login, dynamic model discovery, and streaming inference",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "check": "bun check",
    "check:types": "tsgo -p tsconfig.json --noEmit",
    "test": "bun test"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-ai": ">=18.12.2",
    "@oh-my-pi/pi-catalog": ">=18.12.2",
